APP_NAME="AIDesk Mini"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# With Caddy (profile https): https:// and same host as SAIL_HTTPS_DOMAIN
APP_URL=https://aidesk-mini.loc

# HTTPS reverse proxy (Caddy): put cert.pem + key.pem in docker/certs/, then:
# docker compose --profile https up -d
SAIL_HTTPS_DOMAIN=aidesk-mini.loc
SAIL_HTTPS_PORT=443

# Docker + Caddy: trust proxy so generated URLs use https:// (X-Forwarded-Proto). Tighten in production.
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE="Europe/Warsaw"

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true when using HTTPS (Caddy); false only for plain HTTP without TLS
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_ENCRYPTION=null
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# OpenAI: set OPENAI_FAKE=true for local/CI without a key.
# When OPENAI_FAKE=false, OPENAI_API_KEY is required or OpenAI calls fail.
OPENAI_ENABLED=true
OPENAI_FAKE=true
OPENAI_API_KEY=
